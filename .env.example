# Postgres
DATABASE_URL=postgresql://connect:connect@localhost:5434/connect?schema=public

# Веб-кабинет
SESSION_SECRET=change-me-to-a-long-random-string
GATEWAY_HTTP_URL=http://localhost:8080
INTERNAL_TOKEN=change-me-internal-token

# Шлюз
HTTP_ADDR=:8080
GRPC_ADDR=:50051
PUBLIC_LINK_BASE=http://localhost:8080

# EasySMS. Пока ключ пустой, шлюз работает в макете и не звонит поставщику.
EASYSMS_BASE_URL=https://easysms.co
EASYSMS_API_KEY=
EASYSMS_MOCK=true

# В макете код OTP возвращается в ответе, чтобы можно было проверить validate.
MOCK_REVEAL_OTP=true
